# ---------------------------------------------------------------------------
# ReputeIQ environment
# Copy to `.env` and fill in. Never commit `.env`.
# Values marked REQUIRED are validated at boot by src/lib/env.ts.
# ---------------------------------------------------------------------------

# --- Database (REQUIRED) ---------------------------------------------------
# Pooled connection used by the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reputeiq_dev?schema=public"
# Direct (unpooled) connection used by `prisma migrate`. On Neon/Supabase this
# differs from DATABASE_URL. Locally they are the same.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reputeiq_dev?schema=public"

# Separate database used by `npm test`. Integration tests TRUNCATE it.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reputeiq_test?schema=public"

# --- App (REQUIRED) --------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-at-least-32-characters-of-random-data"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- AI provider -----------------------------------------------------------
# "local"  = deterministic built-in analyzer, no credentials needed (default)
# "openai" = OpenAI Chat Completions with strict JSON schema output
AI_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
# If an OpenAI call fails, fall back to the local analyzer instead of failing
# the job. Recommended true in development, your call in production.
AI_FALLBACK_TO_LOCAL="true"
AI_TIMEOUT_MS="30000"

# --- Review providers ------------------------------------------------------
# Google Business Profile (OAuth 2.0). Without these the source cannot be
# connected in the UI — by design, there is no scraping fallback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Yelp Fusion API
YELP_API_KEY=""

# --- Email -----------------------------------------------------------------
# "console" writes rendered mail to ./.mail and the log. "resend" sends.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="ReputeIQ <reports@example.com>"

# --- Background jobs -------------------------------------------------------
# Bearer token required by POST /api/cron/<job>. Generate: openssl rand -hex 32
CRON_SECRET="change-me"

# --- Billing ---------------------------------------------------------------
# Stripe is stubbed in the MVP; plan changes are applied locally when false.
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Misc ------------------------------------------------------------------
LOG_LEVEL="info"
